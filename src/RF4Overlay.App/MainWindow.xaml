<Window x:Class="RF4Overlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RF4 Overlay" Width="860" Height="740" MinWidth="720" MinHeight="600"
        Background="#111827" Foreground="#F3F4F6" FontFamily="Malgun Gothic">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="RF4 Overlay" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding ConnectionStatus}" Margin="0,8,0,0" Foreground="#CBD5E1"/>
            <Button Content="캡처 진단 이미지 저장" Click="SnapshotClick" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,3"/>
            <TextBlock Text="{Binding InputStatus}" Margin="0,4,0,0" Foreground="#CBD5E1"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#1F2937" Padding="14" CornerRadius="8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Metronome 설정 · 변경은 다음 박자에 반영됩니다."/>
                        <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                            <TextBlock Text="주기(sec, 0.2–60)" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding PeriodText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="소리 주기(초)"
                                     Width="70" Margin="12,0,20,0"/>
                            <TextBlock Text="BPM (1–300)" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding BpmText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="BPM"
                                     Width="70" Margin="12,0,20,0"/>
                            <TextBlock Text="음량" VerticalAlignment="Center"/>
                            <Slider Value="{Binding Volume}" Minimum="0" Maximum="100" Width="170" Margin="12,0,0,0"
                                    AutomationProperties.Name="음량"/>
                            <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" Margin="10,0"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Background="#1F2937" Padding="14" CornerRadius="8" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Auto Pilking 설정 · 변경은 다음 입력 주기에 반영됩니다."/>
                        <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                            <TextBlock Text="자동 입력" VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding AutoInputOptions}" SelectedItem="{Binding SelectedAutoInput}"
                                      DisplayMemberPath="Name" Width="150" Margin="12,0,24,0"
                                      AutomationProperties.Name="Auto Pilking 자동 입력"/>
                            <TextBlock Text="누름(sec)" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding HoldText, UpdateSourceTrigger=LostFocus}" Width="58" Margin="10,0,2,0"
                                     AutomationProperties.Name="Auto Pilking 누름 시간"/>
                            <StackPanel Margin="0,-4,20,-4">
                                <Button Content="▲" Command="{Binding IncreaseHoldCommand}" Width="24" Height="18" FontSize="9"
                                        AutomationProperties.Name="누름 시간 0.1초 증가"/>
                                <Button Content="▼" Command="{Binding DecreaseHoldCommand}" Width="24" Height="18" FontSize="9"
                                        AutomationProperties.Name="누름 시간 0.1초 감소"/>
                            </StackPanel>
                            <TextBlock Text="떼기(sec)" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding ReleaseText, UpdateSourceTrigger=LostFocus}" Width="58" Margin="10,0,2,0"
                                     AutomationProperties.Name="Auto Pilking 떼는 시간"/>
                            <StackPanel Margin="0,-4,0,-4">
                                <Button Content="▲" Command="{Binding IncreaseReleaseCommand}" Width="24" Height="18" FontSize="9"
                                        AutomationProperties.Name="떼는 시간 0.1초 증가"/>
                                <Button Content="▼" Command="{Binding DecreaseReleaseCommand}" Width="24" Height="18" FontSize="9"
                                        AutomationProperties.Name="떼는 시간 0.1초 감소"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding Features}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1F2937" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <WrapPanel><TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding State}" Foreground="#93C5FD" Margin="16,4,0,0"/></WrapPanel>
                                        <TextBlock Text="{Binding Description}" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        <WrapPanel Margin="0,12,0,0">
                                            <TextBlock Text="{Binding HotkeyText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Button Content="{Binding RecordText}" Command="{Binding RecordCommand}" Padding="8,3" AutomationProperties.Name="{Binding RecordAutomationName}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding ButtonText}" Height="36"
                                            Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Name}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel>
                    <TextBlock Text="키 사이 제한(ms)" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding GapText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="단축키 간격" Width="70" Margin="8,0"/>
                    <Button Content="기록 취소" Command="{Binding CancelRecordingCommand}" Padding="10,3"/>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="{Binding Notice}" Foreground="#FBBF24" TextWrapping="Wrap"/>
            <DockPanel Margin="0,8,0,0">
                <Button Content="프로그램 종료" DockPanel.Dock="Right" Click="ExitClick" Padding="12,6"/>
                <TextBlock Text="창 닫기: Tray로 숨김 · 종료: 모든 기능과 입력 관찰 정리" Foreground="#94A3B8" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
