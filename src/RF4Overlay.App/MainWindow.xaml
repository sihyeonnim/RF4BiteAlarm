<Window x:Class="RF4Overlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RF4 Overlay" Width="700" Height="520" MinWidth="610" MinHeight="390"
        Background="#F1F1F1" Foreground="#181818" FontFamily="Malgun Gothic" FontSize="12">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="FlatIconButton" TargetType="Button">
            <Setter Property="Width" Value="25"/><Setter Property="Height" Value="25"/>
            <Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="15"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="FlatGearToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="15"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="CompactButton" TargetType="Button">
            <Setter Property="Height" Value="27"/><Setter Property="Padding" Value="11,2"/>
            <Setter Property="Background" Value="#EEEEEE"/><Setter Property="BorderBrush" Value="#999999"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="CompactInput" TargetType="TextBox">
            <Setter Property="Height" Value="25"/><Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderBrush" Value="#999999"/><Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="CompactCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="18"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Features}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#C8C8C8" BorderThickness="0,0,0,1" Background="#F4F4F4" Padding="6,4">
                            <Grid x:Name="FeatureRoot">
                                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0" HorizontalAlignment="Left">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250"/><ColumnDefinition Width="155"/><ColumnDefinition Width="78"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                                        <ToggleButton x:Name="SettingsToggle" Content="⚙" Style="{StaticResource FlatGearToggle}"
                                                      Margin="5,0,0,0" ToolTip="설정" AutomationProperties.Name="{Binding SettingsAutomationName}"
                                                      Visibility="{Binding HasSettings, Converter={StaticResource BoolVisibility}}"/>
                                        <TextBlock Text="{Binding State}" Foreground="#555555" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HotkeyText}" VerticalAlignment="Center"/>
                                        <Button Content="{Binding RecordText}" Command="{Binding RecordCommand}" Style="{StaticResource FlatIconButton}"
                                                Margin="5,0,0,0" ToolTip="단축키 설정" AutomationProperties.Name="{Binding RecordAutomationName}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{Binding ButtonText}" Command="{Binding ToggleCommand}"
                                            Style="{StaticResource CompactButton}" Width="74" AutomationProperties.Name="{Binding Name}"/>
                                </Grid>

                                <StackPanel Grid.Row="1" Margin="22,1,0,7"
                                            Visibility="{Binding IsChecked, ElementName=SettingsToggle, Converter={StaticResource BoolVisibility}}">
                                    <WrapPanel Visibility="{Binding DataContext.IsBiteAlarm, ElementName=FeatureRoot, Converter={StaticResource BoolVisibility}}"
                                               DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock Text="알람 소리" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding AlarmSounds}" SelectedValue="{Binding AlarmSound}" SelectedValuePath="Sound"
                                                  DisplayMemberPath="Name" Width="130" Height="25" Margin="7,0,12,0"
                                                  AutomationProperties.Name="Bite Alarm 소리 종류"/>
                                        <TextBlock Text="음량" VerticalAlignment="Center"/>
                                        <Slider Value="{Binding AlarmVolume}" Minimum="0" Maximum="100" Width="130" Margin="7,0,0,0"
                                                AutomationProperties.Name="Bite Alarm 음량"/>
                                        <TextBlock Text="{Binding AlarmVolume, StringFormat={}{0:0}%}" Width="39" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                        <Button Content="Test" Command="{Binding TestAlarmCommand}" Style="{StaticResource CompactButton}"/>
                                    </WrapPanel>

                                    <WrapPanel Visibility="{Binding DataContext.IsAutoPilking, ElementName=FeatureRoot, Converter={StaticResource BoolVisibility}}"
                                               DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <TextBlock Text="입력" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding AutoInputOptions}" SelectedItem="{Binding SelectedAutoInput}"
                                                  DisplayMemberPath="Name" Width="135" Height="25" Margin="7,0,12,0"
                                                  AutomationProperties.Name="Auto Pilking 자동 입력"/>
                                        <TextBlock Text="누름" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding HoldText, UpdateSourceTrigger=LostFocus}" Width="50" Margin="7,0,3,0"
                                                 Style="{StaticResource CompactInput}" AutomationProperties.Name="Auto Pilking 누름 시간"/>
                                        <StackPanel Margin="0,-4,10,-4">
                                            <Button Content="▲" Command="{Binding IncreaseHoldCommand}" Width="21" Height="16" FontSize="8" Padding="0"/>
                                            <Button Content="▼" Command="{Binding DecreaseHoldCommand}" Width="21" Height="16" FontSize="8" Padding="0"/>
                                        </StackPanel>
                                        <TextBlock Text="떼기" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding ReleaseText, UpdateSourceTrigger=LostFocus}" Width="50" Margin="7,0,3,0"
                                                 Style="{StaticResource CompactInput}" AutomationProperties.Name="Auto Pilking 떼는 시간"/>
                                        <StackPanel Margin="0,-4,0,-4">
                                            <Button Content="▲" Command="{Binding IncreaseReleaseCommand}" Width="21" Height="16" FontSize="8" Padding="0"/>
                                            <Button Content="▼" Command="{Binding DecreaseReleaseCommand}" Width="21" Height="16" FontSize="8" Padding="0"/>
                                        </StackPanel>
                                    </WrapPanel>

                                    <WrapPanel Visibility="{Binding DataContext.IsLeftClickHold, ElementName=FeatureRoot, Converter={StaticResource BoolVisibility}}"
                                               DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <CheckBox Content="Shift" IsChecked="{Binding ShiftLeftClickHold}" Style="{StaticResource CompactCheckBox}"
                                                  AutomationProperties.Name="Shift와 함께 좌클릭 유지"/>
                                    </WrapPanel>

                                    <WrapPanel Visibility="{Binding DataContext.IsMetronome, ElementName=FeatureRoot, Converter={StaticResource BoolVisibility}}"
                                               DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                        <RadioButton Content="주기" GroupName="MetronomeMode" IsChecked="{Binding IsPeriodMode}" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding PeriodText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsPeriodMode}"
                                                 Width="55" Margin="7,0,4,0" Style="{StaticResource CompactInput}" AutomationProperties.Name="소리 주기(초)"/>
                                        <TextBlock Text="sec" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <RadioButton Content="BPM" GroupName="MetronomeMode" IsChecked="{Binding IsBpmMode}" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding BpmText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsBpmMode}"
                                                 Width="55" Margin="7,0,12,0" Style="{StaticResource CompactInput}" AutomationProperties.Name="BPM"/>
                                        <TextBlock Text="음량" VerticalAlignment="Center"/>
                                        <Slider Value="{Binding Volume}" Minimum="0" Maximum="100" Width="125" Margin="7,0,0,0" AutomationProperties.Name="메트로놈 음량"/>
                                        <TextBlock Text="{Binding Volume, StringFormat={}{0:0}%}" Width="39" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="1" Text="{Binding Notice}" Foreground="#8A5A00" TextWrapping="Wrap" Margin="2,7,2,3"/>

        <Grid Grid.Row="2" Margin="0,5,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox Content="음성 안내" IsChecked="{Binding VoiceAnnouncementEnabled}" Style="{StaticResource CompactCheckBox}"
                          AutomationProperties.Name="음성 안내"/>
                <TextBlock Text="음량" Margin="9,0,0,0" VerticalAlignment="Center"/>
                <Slider Value="{Binding VoiceAnnouncementVolume}" Minimum="0" Maximum="100" Width="110" Margin="6,0,0,0"
                        IsEnabled="{Binding VoiceAnnouncementEnabled}" AutomationProperties.Name="음성 안내 음량"/>
                <TextBlock Text="{Binding VoiceAnnouncementVolume, StringFormat={}{0:0}%}" Width="38" Margin="6,0,5,0" VerticalAlignment="Center"/>
                <Button Content="프로그램 종료" Click="ExitClick" Style="{StaticResource CompactButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
